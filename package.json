{
  "name": "pit-wall",
  "private": true,
  "description": "Fantasy Pit Wall F1 Fantasy planner: checks, tests and backtests (the site itself is built by refresh.py)",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "backtest": "node backtest/run.js",
    "fit": "node backtest/fit.js",
    "rebuild": "node backtest/rebuild_projections.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
