{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "module": "commonjs",
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["engine.js", "hindsight.js"],
  "exclude": ["node_modules"]
}
